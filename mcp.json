{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "docjacket": {
      "type": "streamable-http",
      "url": "https://mcp.docjacket.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "read",
              "draft",
              "actions"
            ]
          }
        }
      }
    }
  }
}

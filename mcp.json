{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "docjacket": {
      "type": "streamable-http",
      "url": "https://mcp.docjacket.com/mcp",
      "headers": {
        "X-DocJacket-Source-App": "codex",
        "X-DocJacket-Plugin-Version": "0.8.0"
      },
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["read", "draft", "actions"]
          }
        }
      }
    }
  }
}
